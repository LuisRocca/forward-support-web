# Copiar a .env  ->  cp .env.example .env
#
# AVISO: en Vite, TODA variable con prefijo VITE_ se inyecta en el bundle y queda
# visible para cualquiera que abra las DevTools. Aquí NUNCA va un secreto, una
# API key ni una credencial: solo configuración pública.

# Absoluta en local; relativa ("/api") cuando front y API comparten dominio.
VITE_API_URL=http://localhost:3000

# Token de SonarQube: se genera en la UI (Account > Security > Generate token).
# No lleva prefijo VITE_, así que Vite no lo inyecta en el bundle. No cambiar
# ese nombre por uno con prefijo: lo haría público.
SONAR_TOKEN=
